---
import { APP_URL } from "../config";
import ButtonLink from "./ButtonLink.astro";
import ThreadsPicture from "./ThreadsPicture.astro";
---

<section id="start" class="relative flex flex-col border-t border-line">
  <div
    class="relative z-2 flex flex-col gap-5 px-5 pt-18 pb-4 md:mx-auto md:box-content md:max-w-cta md:items-center md:gap-7 md:px-6 md:pt-30 md:pb-0 md:text-center"
  >
    <h2
      class="font-display text-50 leading-display-mobile font-medium tracking-tight md:text-final md:leading-display md:tracking-tighter"
    >
      Завяжите узелок на память
    </h2>
    <p class="text-18 text-text-muted md:max-w-lead md:text-21">
      Добавьте того, с кем говорили последним, и запишите, о чём договорились.
    </p>
  </div>

  <!-- Phones: between the text and the button. Desktop: under the button -->
  <ThreadsPicture
    desktop={{ src: "/images/threads-final.svg", width: 1440, height: 360 }}
    mobile={{ src: "/images/threads-final-mobile.svg", width: 600, height: 330 }}
    class="md:order-last"
    imgClass="h-53.5 md:h-80"
  />

  <div class="px-5 pb-14 md:flex md:justify-center md:px-6 md:pt-7 md:pb-10">
    <ButtonLink href={APP_URL} wide>Завязать Узелок</ButtonLink>
  </div>
</section>
